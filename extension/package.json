{
  "name": "vscode-supcode-visuals",
  "displayName": "supcode Visuals for VSCode",
  "description": "supcode’s text displaying conventions for VSCode: `kebab-case` identifiers, half-spaced infix operators, and more!",
  "version": "1.2.1",
  "publisher": "sup2point0",
  "repository": {
    "url": "https://github.com/Sup2point0/vscode-supcode-visuals"
  },
  "engines": {
    "vscode": "^1.106.1"
  },
  "categories": [
    "Formatters",
    "Visualization"
  ],
  "activationEvents": [
    "onLanguage"
  ],
  "main": "./out/extension.js",

  "contributes": {
    "configuration": {
      "title": "supcode Visuals",
      "type":  "object",
      "properties":
      {
        "supcodeVisuals.languages.enabled": {
          "type":   "array",
          "items":  {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "The languages for which supcode visuals are enabled. If none are provided, supcode visuals are enabled for all languages."
        },
        "supcodeVisuals.languages.ignored": {
          "type":    "array",
          "items":   {"type": "string"},
          "default": [
            "plaintext",
            "markdown",
            "latex",
            "json",
            "git-commit",
            "git-rebase"
          ],
          "markdownDescription": "The languages for which supcode visuals are disabled. Applies after `#supcodeVisuals.enabledLanguages#`."
        },

        "supcodeVisuals.features.kebab-Casify": {
          "type":    "boolean",
          "default": true,
          "markdownDescription": "Convert identifiers to `kebab-case`."
        },
        "supcodeVisuals.features.dualShift": {
          "type":    "boolean",
          "default": true,
          "markdownDescription": "Convert spaces around operators to half-width spaces."
        }
      }
    }
  },

  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "22.x",
    "@types/vscode": "^1.106.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
